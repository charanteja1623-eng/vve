# Supabase Configuration
# The Next.js API route will use the Service Role Key to safely insert enquiries
# while bypassing RLS. The Anon Key is listed here for reference if client-side
# reads are needed in the future, but currently all DB interactions happen server-side.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

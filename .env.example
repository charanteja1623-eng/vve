# ==========================================
# Vintage Vibe Events (VVE) - Environment Schema
# ==========================================
# Copy this file to .env.local and populate with your project credentials.
# NEVER commit .env.local or publish secret keys to version control.

# ------------------------------------------
# Supabase Server-Side Configuration (Privileged API)
# ------------------------------------------
# The Next.js API route (/api/enquiry) runs server-side and uses the privileged
# Secret / Service Role Key to safely insert enquiries while bypassing RLS.
# Anonymous public access cannot read or write to the table directly.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Backward-compatible aliases:
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------
# Supabase Client-Side Configuration (Optional)
# ------------------------------------------
# Only configure if client-side browser reads/writes are needed in the future.
# Currently, all enquiry submissions are handled server-side through /api/enquiry.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
